# Environment contract — bloomneo reads this file on every release and fills
# any key the server's shared/.env is missing.
#
#   PORT      -> the port assigned to the deploy target
#   NODE_ENV  -> always "production"
#
# This site has no database, auth or API calls, so nothing else is needed.
# Local dev:  cp .env.example .env

NODE_ENV=development
PORT=3000

# Recommended by appkit in production (plain key: copied verbatim)
BLOOM_SERVICE_NAME=well-life-advisors
